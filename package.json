{
  "name": "aiPowered_monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "npm install",
    "dev:web": "npm --workspace=apps/web-app run dev",
    "build:web": "npm --workspace=apps/web-app run build",
    "start:web": "npm --workspace=apps/web-app run start",
    "lint": "npm --workspace=apps/web-app run lint"
  }
}
{
  "name": "ecomm-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.4.2",
    "@google/genai": "^2.6.0",
    "axios": "^1.16.1",
    "mongoose": "^9.6.3",
    "next": "16.2.6",
    "next-auth": "^4.24.14",
    "openai": "^6.39.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
