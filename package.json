{
  "name": "aiPowered_monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "npm install",
    "dev:web": "npm --workspace=apps/web-app run dev",
    "build:web": "npm --workspace=apps/web-app run build",
    "start:web": "npm --workspace=apps/web-app run start",
    "lint": "npm --workspace=apps/web-app run lint"
  }
}
